# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://kivjcxpbcqmmowgdhico.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Secret key — server-side only, NEVER prefix with NEXT_PUBLIC_, never commit
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay — server-side only for the secret; both required to create orders
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# OpenAI — for admin "Generate with AI" product descriptions (server-side only)
OPENAI_API_KEY=

# Cloudflare Turnstile — optional CAPTCHA on /admin/login. Leave both blank
# to skip it entirely (login still works, just without a CAPTCHA step).
# Get free keys at https://dash.cloudflare.com/?to=/:account/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# WhatsApp order number, shown to customers (public, no country-code +, e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=917418353535

# Instagram profile URL, used in the footer
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/hanaburka/
